{
  "name": "dashboard",
  "version": "1.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve --proxy-config proxy.conf.json",
    "prebuild": "pnpm validate:brand",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "pretest": "pnpm validate:brand",
    "test": "ng test --watch=false",
    "validate:brand": "node scripts/validate-brand-assets.mjs",
    "format": "prettier --write \"src/**/*.{ts,html,scss}\" \"*.{json,md}\"",
    "format:check": "prettier --check \"src/**/*.{ts,html,scss}\" \"*.{json,md}\""
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "packageManager": "pnpm@11.9.0",
  "dependencies": {
    "@angular/common": "21.1.5",
    "@angular/compiler": "21.1.5",
    "@angular/core": "21.1.5",
    "@angular/forms": "21.1.5",
    "@angular/platform-browser": "21.1.5",
    "@angular/router": "21.1.5",
    "@fontsource/inter": "5.2.8",
    "@fontsource/jetbrains-mono": "5.2.8",
    "echarts": "6.1.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "21.1.5",
    "@angular/cli": "21.1.5",
    "@angular/compiler-cli": "21.1.5",
    "jsdom": "^27.1.0",
    "prettier": "^3.9.6",
    "typescript": "~5.9.2",
    "vitest": "^4.0.8"
  }
}
